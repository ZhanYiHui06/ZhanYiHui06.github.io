# Caddy: automatic HTTPS (Let's Encrypt) with no extra setup.
# Install:  https://caddyserver.com/docs/install
# Use:      sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Replace ruofu.site with your domain (its DNS A record must point at this server).

# www → apex, so there is a single canonical address
www.ruofu.site {
	redir https://ruofu.site{uri} permanent
}

ruofu.site {
	root * /var/www/personal-page
	encode zstd gzip

	# fingerprinted build assets never change, cache them for a year
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# pages: always revalidate so content updates show up immediately
	@pages path / /*.html
	header @pages Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
