---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric' }).format(new Date(date));
}
---

<BaseLayout>
  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-4 sm:px-8 py-20 sm:py-24">
    <div class="flex items-center gap-2.5 mb-5 text-xs text-[var(--ink-3)] tracking-wider uppercase">
      <div class="w-5 h-px bg-[var(--ink-4)]"></div>
      小小产品人的学习日志
    </div>
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl leading-tight mb-5 tracking-tight">
      你好，我是 <em class="italic text-[var(--accent)]">Ruofu</em><br />
      在这里记录思考
    </h1>
    <p class="text-base text-[var(--ink-2)] leading-relaxed max-w-xl mb-8 font-light">
      一个对产品、设计与人性充满好奇的探索者。这里有我的行业观察、实用教程，以及偶尔的生活随笔。不追求数量，只求每篇都说点真话。
    </p>
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="bg-white border border-[var(--border)] px-3.5 py-1.5 rounded-full text-xs text-[var(--ink-3)]">产品思维</span>
      <span class="bg-white border border-[var(--border)] px-3.5 py-1.5 rounded-full text-xs text-[var(--ink-3)]">用户研究</span>
      <span class="bg-white border border-[var(--border)] px-3.5 py-1.5 rounded-full text-xs text-[var(--ink-3)]">行业洞察</span>
      <span class="bg-white border border-[var(--border)] px-3.5 py-1.5 rounded-full text-xs text-[var(--ink-3)]">工具方法</span>
      <span class="bg-white border border-[var(--border)] px-3.5 py-1.5 rounded-full text-xs text-[var(--ink-3)]">生活随笔</span>
    </div>
    <a href="/posts" class="inline-flex items-center gap-2 bg-[var(--accent)] text-white px-5 py-2.5 text-xs tracking-wider uppercase transition-colors hover:bg-[var(--accent-dark)] font-sans">
      阅读文章
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <!-- Recent posts -->
  <section class="max-w-3xl mx-auto px-4 sm:px-8 pb-20">
    <div class="flex items-center gap-3 mb-7 text-xs text-[var(--ink-4)] tracking-wider uppercase">
      最近更新
      <div class="flex-1 h-px bg-[var(--border)]"></div>
    </div>

    {recentPosts.map((post) => (
      <a href={`/posts/${post.slug}`} class="block grid grid-cols-12 gap-6 py-5 border-b border-[var(--border)] hover:opacity-70 transition-opacity fade-up">
        <div class="col-span-2 text-xs text-[var(--ink-4)] font-light pt-1 tracking-wide">{formatDate(post.data.date)}</div>
        <div class="col-span-8">
          <h3 class="font-serif text-lg mb-1 text-[var(--ink)] hover:text-[var(--accent)] transition-colors">{post.data.title}</h3>
          <p class="text-xs text-[var(--ink-3)] leading-relaxed font-light">{post.data.excerpt}</p>
        </div>
        <div class="col-span-2 hidden md:block">
          <span class="inline-block border border-[var(--border)] px-2.5 py-1 rounded-full text-[10px] text-[var(--ink-3)]">{post.data.category}</span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
